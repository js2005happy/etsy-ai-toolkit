# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: used by webhook + server routes to bypass RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=

# ---- AI ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=
MOMA_VISION_API_KEY=
USE_MOCK_AI=false

# ---- MCP ----
MCP_API_KEY=
MCP_USER_ID=

# ---- Paddle ----
PADDLE_API_KEY=
PADDLE_ENV=production
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=production

# ---- Analytics (PostHog) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Analytics (Google Analytics) ----
NEXT_PUBLIC_GA_ID=

# ---- Shopify ----
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Must exactly match a URL in the Shopify app's allowed redirects.
SHOPIFY_REDIRECT_URI=

# ---- Etsy ----
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=

# ---- Multichannel credential encryption ----
# Server-only secret used to AES-256-GCM encrypt new WooCommerce/eBay credentials
# before persistence. Use a long, random production secret and never expose it to clients.
COMMERCE_CREDENTIALS_KEY=

# ---- eBay ----
# eBay developer application keys. EBAY_REDIRECT_URI_NAME is the RuName configured
# in the eBay developer console, not a raw callback URL.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI_NAME=
# production | sandbox
EBAY_ENV=production
