# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: used by webhook + server routes to bypass RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email (Resend) ----
# API key from resend.com. If unset, transactional emails are silently skipped.
RESEND_API_KEY=
# Verified "from" address on your Resend domain, e.g. Craftly <no-reply@craftly.world>.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where contact-form and sale notifications are sent. Defaults if unset.
CONTACT_TO_EMAIL=

# ---- AI ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=
# 移动云视觉模型（moma.cmecloud.cn），用于图片海报 OCR 翻译
MOMA_VISION_API_KEY=
USE_MOCK_AI=false

# ---- MCP ----
# Secret shared between this site and the MCP server. The MCP server sends it as
# the `x-mcp-key` header; matching it authenticates the call as the service account below.
MCP_API_KEY=
# UUID of a Supabase `profiles` row that acts as the MCP service account. MCP calls
# are attributed to this user, so credits are deducted and generations are recorded.
MCP_USER_ID=

# ---- Paddle (live) ----
# Live API key (pdl_live_...). Used for checkout, portal, and webhook verification.
PADDLE_API_KEY=
# production | sandbox
PADDLE_ENV=production
# Price ID for the Pro subscription (created in Paddle > Catalog > Prices).
PADDLE_PRO_PRICE_ID=
# Webhook SIGNING secret (NOT the API key). From Paddle > Developer tools >
# Notifications — shown once when you create the destination.
PADDLE_WEBHOOK_SECRET=
# Client-side token for Paddle.js (prefixed live_/test_). Safe to expose in the
# browser — this is NOT the API key. From Paddle > Developer tools > Authentication.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# production | sandbox — must match the client token's environment.
NEXT_PUBLIC_PADDLE_ENV=production

# ---- Analytics (PostHog) ----
# From app.posthog.com > Project settings. Empty = PostHog disabled.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Analytics (Google Analytics) ----
# Google Analytics 4 measurement ID (G-XXXXXXX). Empty = GA disabled.
NEXT_PUBLIC_GA_ID=

# ---- Shopify ----
# From Shopify Partners/Dev Dashboard > your app > Client credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Must exactly match a URL in the app's "Allowed redirection URL(s)".
SHOPIFY_REDIRECT_URI=

# ---- Etsy ----
# Keystring from Etsy > Developers > your app. Etsy v3 uses OAuth 2.0 PKCE —
# the keystring acts as client_id for the token exchange.
ETSY_API_KEY=
# Shared secret from Etsy > Developers > your app. Required in the x-api-key
# header (keystring:shared_secret) for all v3 API requests since 2026-01-18.
ETSY_SHARED_SECRET=
# Must exactly match a URL in the app's "Callback URI". e.g.
# https://craftly.world/api/etsy/callback
ETSY_REDIRECT_URI=
